# Ellie v5 configuration. Copy to .env (chmod 600). `npm run doctor` checks everything below.
# On the VPS, deploy/vps.sh configure builds .env from ~/backups/v2-preservation/.env.

NODE_ENV=production
PORT=3001
# All state lives here (app.sqlite, ledger.sqlite, private/). Keep it off synced folders.
ELLIE_DATA_DIR=/home/ellie/.local/share/ellie
# Owner files such as never-claims.json (default: $ELLIE_DATA_DIR/private)
# ELLIE_PRIVATE_DIR=
# Public URL (webhooks, Google OAuth callback). On the VPS this is the Tailscale Funnel address.
ELLIE_PUBLIC_URL=https://ellie.example.com
# Control page address used in Slack links (tailnet only), e.g. https://<host>.ts.net:10000
ELLIE_CONTROL_URL=

# Owner (P12: never hard-coded in src/)
ELLIE_OWNER_NAME=
ELLIE_OWNER_FULL_NAME=
# Your timezone for "today"/"tomorrow" and calendar days (default Europe/Warsaw)
ELLIE_TIMEZONE=Europe/Warsaw
ELLIE_OWNER_ACTOR=owner

# Control page login (required in production; the server refuses to start without it)
ELLIE_CONTROL_PLANE_TOKEN=
# Token-free listener on 127.0.0.1 for the tailnet. Point ONLY tailscale serve at it:
#   tailscale serve --bg --https=10000 http://127.0.0.1:3002
ELLIE_PRIVATE_PORT=3002

# Gemini
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-3.8-flash
# Reasoning model for routines whose model is "reasoning"/"pro" (doctor checks the id exists)
GEMINI_REASONING_MODEL=
# Image generation model (Google Nano Banana, default: gemini-3.1-flash-image)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Slack reply thinking level: low | medium (default) | high. Tool failures escalate to high.
GEMINI_INTERACTIVE_THINKING=medium
# Explicit context cache for the system prompt + tools (on by default)
# GEMINI_PREFIX_CACHE=off

# Google Workspace OAuth (connect at <ELLIE_PUBLIC_URL>/api/integrations/google/connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OPERATOR_EMAIL=
# Defaults to <ELLIE_PUBLIC_URL>/api/integrations/google/callback
# GOOGLE_WORKSPACE_REDIRECT_URI=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_USER_ID=
SLACK_OWNER_USER_ID=
SLACK_CHANNEL_ID=

# Proton Mail Bridge (optional)
PROTON_IMAP_HOST=127.0.0.1
PROTON_IMAP_PORT=1143
PROTON_SMTP_PORT=1025
PROTON_USERNAME=
PROTON_BRIDGE_PASSWORD=
# PROTON_ENABLED=false
# PROTON_ALLOW_SELFSIGNED_TLS=true

# Ellie Gateway (MCP: Ads + LinkedIn reads), Apify, and Composio (optional; tools hidden when unset)
ELLIE_MCP_GATEWAY_URL=
ELLIE_MCP_GATEWAY_KEY=
APIFY_API_TOKEN=
# APIFY_LINKEDIN_PROFILE_ACTOR=curious_coder~linkedin-profile-scraper
# APIFY_LINKEDIN_POSTS_ACTOR=lightmoon~linkedin-profile-posts-scraper
COMPOSIO_API_KEY=
# COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1
# COMPOSIO_USER_ID=default

# Governance
ELLIE_SEND_ALLOWLIST=
ELLIE_MAX_DAILY_SENDS=15
ELLIE_APPROVAL_EXPIRY_MINUTES=120

# Owner documents and named resources
ELLIE_OWNER_CONFIG_DOC_ID=
ELLIE_PROFESSIONAL_RECORD_DOC_ID=
ELLIE_CLAIMS_BANK_DOC_ID=
ELLIE_PROSPECT_TRACKER_ID=
ELLIE_TARGET_TRACKER_ID=
