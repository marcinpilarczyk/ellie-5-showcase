{
  "name": "ellie",
  "version": "5.0.0",
  "private": true,
  "license": "MIT",
  "description": "Ellie v5 - Slack-first AI chief of staff",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "wake": "node dist/wake.js",
    "predoctor": "npm run build --silent",
    "doctor": "node dist/scripts/doctor.js",
    "google-token:export": "node dist/scripts/google-token.js export",
    "google-token:import": "node dist/scripts/google-token.js import",
    "dev": "tsx watch src/index.ts",
    "pretest": "npm run build --silent",
    "test": "node --env-file=.env.test --test dist/test/*.test.js",
    "test:ts": "node --env-file=.env.test --import tsx --test src/test/*.test.ts",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "docx": "9.7.2",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "googleapis": "^188.0.0",
    "imapflow": "^1.0.171",
    "jszip": "3.10.1",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
